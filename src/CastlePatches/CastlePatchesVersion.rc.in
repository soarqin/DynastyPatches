#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @CASTLEPATCHES_VERSION_FILE@
 PRODUCTVERSION @CASTLEPATCHES_VERSION_FILE@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE @CASTLEPATCHES_FILE_TYPE@
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "Dynasty Patches"
            VALUE "FileDescription", "@CASTLEPATCHES_FILE_DESCRIPTION@"
            VALUE "FileVersion", "@CASTLEPATCHES_VERSION@"
            VALUE "InternalName", "@CASTLEPATCHES_INTERNAL_NAME@"
            VALUE "LegalCopyright", "Copyright (c) 2026 Soar Qin"
            VALUE "OriginalFilename", "@CASTLEPATCHES_ORIGINAL_FILENAME@"
            VALUE "ProductName", "Castle Patches"
            VALUE "ProductVersion", "@CASTLEPATCHES_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
