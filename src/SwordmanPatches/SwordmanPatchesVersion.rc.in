#include <windows.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SWORDMANPATCHES_VERSION_FILE@
 PRODUCTVERSION @SWORDMANPATCHES_VERSION_FILE@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE @SWORDMANPATCHES_FILE_TYPE@
 FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "080404B0"
  BEGIN
   VALUE "CompanyName", "Dynasty Patches"
   VALUE "FileDescription", "@SWORDMANPATCHES_FILE_DESCRIPTION@"
   VALUE "FileVersion", "@SWORDMANPATCHES_VERSION@"
   VALUE "InternalName", "@SWORDMANPATCHES_INTERNAL_NAME@"
   VALUE "OriginalFilename", "@SWORDMANPATCHES_ORIGINAL_FILENAME@"
   VALUE "ProductName", "Swordman Patches"
   VALUE "ProductVersion", "@SWORDMANPATCHES_VERSION@"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0804, 1200
 END
END
